+describe('JARVIS skin default', () => {
+  beforeEach(() => window.localStorage.clear())
+
+  it('is used for first launch and invalid persisted values', () => {
+    expect(DEFAULT_SKIN_NAME).toBe('jarvis')
+    expect(skinPref.resolve('default')).toBe('jarvis')
+    window.localStorage.setItem('hermes-desktop-theme-v2', 'missing-theme')
+    expect(skinPref.resolve('default')).toBe('jarvis')
+  })
+
+  it('does not override valid global or per-profile user choices', () => {
+    skinPref.assign('default', 'midnight')
+    skinPref.assign('work', 'ember')
+    expect(skinPref.resolve('default')).toBe('midnight')
+    expect(skinPref.resolve('work')).toBe('ember')
+  })
+
+  it('restores JARVIS when settings are reset to defaults', () => {
+    skinPref.assign('default', 'midnight')
+    skinPref.assign('work', 'ember')
+    resetSkinPreferences()
+    expect(skinPref.resolve('default')).toBe('jarvis')
+    expect(skinPref.resolve('work')).toBe('jarvis')
+  })
+})
