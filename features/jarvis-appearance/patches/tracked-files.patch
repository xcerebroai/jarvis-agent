+/** Reset every profile's skin assignment to the product default. */
+export function resetSkinPreferences(): void {
+  if (typeof window === 'undefined') return
+  window.localStorage.removeItem(SKIN_KEY)
+  window.localStorage.removeItem(PROFILE_SKINS_KEY)
+  window.dispatchEvent(new StorageEvent('storage'))
+}
