+
+    with _config_profile_scope(profile):
+        config = load_config() or {}
+        home = get_hermes_home()
+
+    return realtime_voice.resolve_voice_config(home, config)
+
+
+@app.post("/api/audio/realtime/token")
+async def mint_realtime_token(
+    payload: Optional[RealtimeTokenRequest] = None,
+    profile: Optional[str] = None,
+):
+    """Mint a short-lived OpenAI Realtime ephemeral client secret.
+
+    The desktop's production voice transport is a browser WebRTC
+    speech-to-speech session against OpenAI Realtime. The browser must never
+    see the standing ``OPENAI_API_KEY``; instead it authenticates its WebRTC
+    SDP exchange with a short-lived *ephemeral* secret minted here.
+
+    The standing key is read from the requested profile's scope
+    (``resolve_openai_audio_api_key`` — ``VOICE_TOOLS_OPENAI_KEY`` then
+    ``OPENAI_API_KEY``), used only as the Bearer for the outbound mint, and
+    never returned or logged. Only the ephemeral value + non-secret session
+    metadata the renderer needs are returned.
+    """
+    global _realtime_mint_error_logged_once
+
+    from hermes_cli import realtime_voice
+    from hermes_constants import get_hermes_home
+
+    body = payload or RealtimeTokenRequest()
+
+    # Config-only scope (await-safe): resolves the requested profile's .env /
+    # credential pool and config.yaml defaults, matching the profile the
+    # settings UI writes to. A bad profile raises 400/404 here and is re-raised.
+    with _config_profile_scope(profile):
+        from tools.tool_backend_helpers import resolve_openai_audio_api_key
+
+        defaults = realtime_voice.resolve_token_defaults(get_hermes_home(), load_config() or {})
+        api_key = (resolve_openai_audio_api_key() or "").strip()
+
+    model = (body.model or "").strip() or defaults["model"]
+    voice = (body.voice or "").strip() or defaults["voice"]
+
+    if not api_key:
+        # Phrase kept recognizable to the renderer's error summarizer so the
+        # user gets an actionable "add your OpenAI key" toast rather than a raw
+        # 400. The standing key is absent — nothing to leak.
+        raise HTTPException(
+            status_code=400,
+            detail=(
+                "Realtime voice needs an OpenAI key: neither "
+                "VOICE_TOOLS_OPENAI_KEY nor OPENAI_API_KEY is set."
+            ),
+        )
+
+    request_body = json.dumps(
+        {
+            "session": {
+                "type": "realtime",
+                "model": model,
+                "audio": {"output": {"voice": voice}},
+            }
+        }
+    ).encode("utf-8")
+    request = urllib.request.Request(
+        _REALTIME_CLIENT_SECRETS_URL,
+        data=request_body,
+        method="POST",
+        headers={
+            "Authorization": f"Bearer {api_key}",
+            "Content-Type": "application/json",
+        },
+    )
+
+    loop = asyncio.get_running_loop()
+
+    def _fetch() -> Dict[str, Any]:
+        with urllib.request.urlopen(request, timeout=_REALTIME_MINT_TIMEOUT_S) as response:
+            return json.loads(response.read().decode("utf-8"))
+
+    try:
+        data = await loop.run_in_executor(None, _fetch)
+    except urllib.error.HTTPError as exc:
+        # Sanitize: the upstream error body can echo request context. Surface a
+        # stable, key-free reason keyed on status. 401/403 → the standing key is
+        # bad; other codes → an upstream failure.
+        if exc.code in (401, 403):
+            if not _realtime_mint_error_logged_once:
+                _log.warning("Realtime token mint rejected by OpenAI (auth)")
+                _realtime_mint_error_logged_once = True
+            raise HTTPException(
+                status_code=502,
+                detail="OpenAI rejected the API key for Realtime voice.",
+            )
+        _log.warning("Realtime token mint failed (HTTP %s)", exc.code)
+        raise HTTPException(
+            status_code=502,
+            detail=f"Could not start Realtime voice session (HTTP {exc.code}).",
+        )
+    except HTTPException:
+        raise
+    except Exception:
+        _log.exception("Realtime token mint failed")
+        raise HTTPException(
+            status_code=502,
+            detail="Could not start Realtime voice session.",
+        )
+
+    # OpenAI returns the ephemeral secret as ``value`` (GA client_secrets) or,
+    # on older shapes, nested under ``client_secret.value``. Never fall through
+    # to any field that could carry the standing key.
+    value = ""
+    if isinstance(data, dict):
+        raw_value = data.get("value")
+        if isinstance(raw_value, str):
+            value = raw_value.strip()
+        if not value:
+            secret = data.get("client_secret")
+            if isinstance(secret, dict) and isinstance(secret.get("value"), str):
+                value = secret["value"].strip()
+
+    if not value:
+        _log.warning("Realtime token mint returned no ephemeral value")
+        raise HTTPException(
+            status_code=502,
+            detail="Realtime voice session did not return a token.",
+        )
+
+    session = data.get("session") if isinstance(data, dict) else None
+    session_id = ""
+    if isinstance(session, dict) and isinstance(session.get("id"), str):
+        session_id = session["id"]
+    expires_at = data.get("expires_at") if isinstance(data, dict) else None
+
+    return {
+        "ok": True,
+        "value": value,
+        "expires_at": expires_at if isinstance(expires_at, (int, float)) else None,
+        "model": model,
+        "voice": voice,
+        "session_id": session_id,
+    }
+
