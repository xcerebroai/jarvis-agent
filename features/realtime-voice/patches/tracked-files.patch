@@ -132,6 +132,45 @@ test('repeated busy reports do not re-apply or stack timers', () => {
   assert.equal(timers.pendingCount, 1)
 })
 
+test('a live voice session unthrottles the main window (backgroundThrottling false) with no turn in flight', () => {
+  const timers = makeTimers()
+  const throttle = createStreamThrottle(timers)
+  const win = makeWindow()
+  throttle.register(win)
+
+  // Idle default: throttling allowed (backgroundThrottling true).
+  assert.deepEqual(win.calls, [true])
+
+  // Voice comes online — WebRTC/audio/timers must not be throttled even when
+  // the window is minimized, so backgroundThrottling is forced false.
+  throttle.setVoiceActive(true)
+  assert.deepEqual(win.calls, [true, false])
+  assert.equal(throttle.isUnthrottled(), true)
+
+  // Ending voice re-throttles after the trailing delay.
+  throttle.setVoiceActive(false)
+  assert.deepEqual(win.calls, [true, false])
+  timers.fire()
+  assert.deepEqual(win.calls, [true, false, true])
+  assert.equal(throttle.isUnthrottled(), false)
+})
+
+test('voice active keeps windows unthrottled even as a streaming turn ends', () => {
+  const timers = makeTimers()
+  const throttle = createStreamThrottle(timers)
+  const win = makeWindow()
+  throttle.register(win)
+
+  throttle.setVoiceActive(true)
+  throttle.update(true)
+  assert.deepEqual(win.calls, [true, false])
+
+  // The turn ends but voice is still live — no trailing re-throttle is armed.
+  throttle.update(false)
+  assert.equal(timers.pendingCount, 0)
+  assert.equal(throttle.isUnthrottled(), true)
+})
+
 test('closed and destroyed windows drop out without throwing', () => {
   const timers = makeTimers()
   const throttle = createStreamThrottle(timers)
