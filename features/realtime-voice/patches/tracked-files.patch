+# --- Desktop Realtime speech-to-speech voice (JARVIS overlay feature) ---------
+# Three endpoints power the desktop's optional browser WebRTC voice transport:
+#   * POST /api/audio/realtime/config          — the configurable voice identity
+#   * POST /api/audio/realtime/token           — mint a short-lived ephemeral
+#                                                 client secret (never the key)
+#   * POST /api/audio/realtime/project-review  — the optional project-index fast
+#                                                 path (disabled unless a local
+#                                                 index is configured)
+# All heavy/testable logic lives in hermes_cli/realtime_voice.py; these handlers
+# only resolve the profile scope + standing key and shape the HTTP responses.
+_REALTIME_CLIENT_SECRETS_URL = "https://api.openai.com/v1/realtime/client_secrets"
+# Bound the outbound mint so a hung OpenAI edge can't wedge the desktop's
+# voice-start (mirrors the ElevenLabs-voices fetch bound).
+_REALTIME_MINT_TIMEOUT_S = 15
+# Log the standing-key-missing case at most once per process — never log the key
+# itself or the ephemeral value.
+_realtime_mint_error_logged_once = False
+
+
+@app.post("/api/audio/realtime/config")
