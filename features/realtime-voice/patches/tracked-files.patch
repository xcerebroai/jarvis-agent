+@app.post("/api/audio/realtime/project-review")
+async def realtime_project_review(
+    payload: Optional[RealtimeProjectReviewRequest] = None,
+    profile: Optional[str] = None,
+):
+    """Compact, deterministic review of the operator's configured project index.
+
+    Reads the local JSON index at ``voice.realtime.review_projects.index_path``.
+    There is no built-in default path: when no index is configured (or the file
+    is absent) the endpoint 404s and the renderer omits the tool entirely.
+    """
+    from hermes_cli import realtime_voice
+    from hermes_constants import get_hermes_home
+
+    request = payload or RealtimeProjectReviewRequest()
+
+    with _config_profile_scope(profile):
+        config = load_config() or {}
+        source = realtime_voice.resolve_index_path(get_hermes_home(), config)
+
+    if source is None or not source.exists():
+        raise HTTPException(
+            status_code=404,
+            detail="No project index is configured (voice.realtime.review_projects.index_path).",
+        )
+
+    try:
+        data = json.loads(source.read_text(encoding="utf-8"))
+    except Exception:
+        raise HTTPException(status_code=502, detail="The configured project index could not be read.")
+
+    # Voice-created projects live in a local overlay beside the synced index
+    # (the hourly sync overwrites the index wholesale); merge them for reads.
+    local_rows = realtime_voice.read_local_additions(source)
+    if local_rows:
+        merged = data.get("projects") if isinstance(data, dict) else data
+        if isinstance(merged, list):
+            data = {**data, "projects": [*merged, *local_rows]} if isinstance(data, dict) else [*merged, *local_rows]
+
+    return realtime_voice.build_project_review(
+        data,
+        query=request.query,
+        status_filter=request.status,
+        limit=request.limit,
+        detail=bool(getattr(request, "detail", False)),
+        index_path=source,
+    )
